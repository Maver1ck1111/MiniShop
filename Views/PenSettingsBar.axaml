<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="MiniShop.Views.PenSettingsBar">
	
	<StackPanel 
		Spacing="5">
		<TextBlock 
			x:Name="PixelSizeBlock"
            Text="Choose pen size"
            FontSize="14"/>
		
		<TextBox 
			x:Name="PenSizeBox"
			TextChanged="OnSizeChanged" />

		<ComboBox x:Name="PenColorComboBox" SelectionChanged="PenColorChangedBox">
			<ComboBoxItem Content="Black"/>
			<ComboBoxItem Content="Red"/>
			<ComboBoxItem Content="White"/>
			<ComboBoxItem Content="Yellow"/>
			<ComboBoxItem Content="Green"/>
		</ComboBox>

		<TextBlock
			x:Name="OpacityBlock"
			Text="Choose Opacity"
			FontSize="14"/>
		
		<TextBox 
			x:Name="OpacityTexBox"
			TextChanged="OnOpacityChanged" />
		
	</StackPanel>

</UserControl>
