<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="clr-namespace:MiniShop"
			 Background="#262626"
             x:Class="MiniShop.ImageViewer">
	<Grid>
		<Border x:Name="ViewportBorder"
        ClipToBounds="True"
		PointerWheelChanged="OnCanvasPointerWheelChanged"
		PointerReleased="OnCanvasPointerReleased"
		PointerPressed="OnCanvasPointerPressed" 
		PointerMoved="OnCanvasPointerMoved">

			<Canvas x:Name="ImageCanvas" RenderTransformOrigin="0,0">
				<Image
					x:Name="Image"/>
			</Canvas>
		</Border>

		<Button x:Name="SelectImageButton"
            Content="Select Image"
            Click="OnSelectImageClicked"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
	</Grid>
	
</UserControl>
